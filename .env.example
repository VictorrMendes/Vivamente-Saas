DATABASE_URL=postgresql://user:pass@host:5432/vivamente
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

FIREBASE_CREDENTIALS_PATH=.secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=changeme

RESEND_API_KEY=changeme
RESEND_FROM_EMAIL=nao-responda@vivamenteterapias.com.br

# URL interna do servico Back e chave PRIVADA (RS256, PEM com \n literais
# numa linha so) usada para assinar o JWT de servico da API
# /api/v1/internal/identity/* (ver apps/auth/back_sync.py). O Back valida
# com a chave PUBLICA correspondente (INTERNAL_SERVICE_JWT_PUBLIC_KEY no
# .env dele) - nunca com a mesma chave, entao um Back comprometido nao
# consegue forjar um token do Oauth. Gere o par com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Restrinja BACK_INTERNAL_URL a rede privada (Traefik) quando essa infra existir.
BACK_INTERNAL_URL=http://back:8000
BACK_INTERNAL_SERVICE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nchangeme\n-----END PRIVATE KEY-----
BACK_INTERNAL_JWT_TTL_SECONDS=60
BACK_SYNC_TIMEOUT_SECONDS=3
