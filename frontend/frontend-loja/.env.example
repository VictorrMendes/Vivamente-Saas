# URL pública do site, usada em metadados/canonical/OG. Pode ser exposta ao browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL do Back (Django). Uso exclusivamente server-side (Server Components/Actions) —
# nunca prefixar com NEXT_PUBLIC_, nunca referenciar de um Client Component.
BACK_API_URL=http://localhost:8000

# Opcional, só dev: MOCK_BACK=1 troca as chamadas ao Back por dados fictícios
# (src/lib/api/mocks.ts), pra visualizar a Loja sem precisar subir o Back.
# Nunca funciona em produção (bloqueado por NODE_ENV) mesmo se setado.
# MOCK_BACK=1
